db.connect_default();
print("=== Teste de datas na tabela equipamentos ===\n");

// Limpar só os de teste
db.execute("DELETE FROM equipamentos WHERE codigo_letras LIKE $1", ["ZZTEST%"]);

// 1) INSERT com cast nativo (sem ::date)
print("1) Insert com cast nativo:");
db.execute(
    "INSERT INTO equipamentos (codigo_letras, codigo_numeros, modelo, data_entrada, data_saida, defeito, status) VALUES ($1, $2, $3, $4, $5, $6, $7)",
    ["ZZTEST1", "0001", "Notebook Dell", "2026-01-15" as date, "2026-02-20" as date, "Nao liga", "liberado"]
);
print("   OK - sem ::date\n");

// 2) INSERT com now() e today()
print("2) Insert com today() e now():");
db.execute(
    "INSERT INTO equipamentos (codigo_letras, codigo_numeros, modelo, data_entrada, defeito, status) VALUES ($1, $2, $3, $4, $5, $6)",
    ["ZZTEST2", "0002", "Monitor LG", today(), "Tela quebrada", "avaliacao"]
);
print("   OK - usando today()\n");

// 3) SELECT com datas legíveis
print("3) Select mostrando datas:");
let eq = db.query(
    "SELECT id, codigo_letras, codigo_numeros, data_entrada, data_saida, criado_em FROM equipamentos WHERE codigo_letras LIKE $1 ORDER BY id",
    ["ZZTEST%"]
);
for e in eq {
    print("   ID:", e["id"]);
    print("     codigo:", e["codigo_letras"], "-", e["codigo_numeros"]);
    print("     entrada:", e["data_entrada"]);
    print("     saida:", e["data_saida"]);
    print("     criado_em:", e["criado_em"]);
    print("");
}

// 4) Filtro por data
print("4) Filtro por data (data_entrada >= 2026-02-01):");
let recentes = db.query(
    "SELECT codigo_letras, data_entrada FROM equipamentos WHERE data_entrada >= $1 AND codigo_letras LIKE $2",
    ["2026-02-01" as date, "ZZTEST%"]
);
for e in recentes {
    print("   ", e["codigo_letras"], "->", e["data_entrada"]);
}
print("");

// 5) now() e today()
print("5) now() e today():");
let agora = now();
let hoje = today();
print("   today():", hoje);
print("   now():", agora);
print("");

// 6) Limpar
db.execute("DELETE FROM equipamentos WHERE codigo_letras LIKE $1", ["ZZTEST%"]);
print("Teste concluido e registros ZZTEST removidos.");
