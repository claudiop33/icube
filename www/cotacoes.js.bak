/* ========================================================
   Icube Cotações — Single Page Application
   ======================================================== */

const API_URL = '/api/equipamentos';
const PER_PAGE = 20;

const STATUS_OPTIONS = [
    { value: 'pendente', label: 'Pendente', cls: 'status-avaliacao' },
    { value: 'extraido', label: 'Extraído', cls: 'status-reparado'  },
    { value: 'falhou',   label: 'Falhou',   cls: 'status-pecas'     },
    { value: 'manual',   label: 'Manual',   cls: 'status-liberado'  },
];

const state = {
    page: 1,
    total: 0,
    rows: [],
    filters: {
        peca: '', modelo: '', fornecedor: '', categoria: '',
        status: '', precoMin: '', precoMax: '', dataDe: '', dataAte: '',
    },
    busy: false,
};

/* ====== Utils ====== */

function escapeIcube(s) {
    return String(s ?? '')
        .replace(/\\/g, '\\\\')
        .replace(/"/g, '\\"')
        .replace(/\n/g, '\\n')
        .replace(/\r/g, '\\r')
        .replace(/\t/g, '\\t');
}

function icubeStr(s)   { return `"${escapeIcube(s)}"`; }
function icubeInt(n)   { return String(Number(n) | 0); }
function icubeFloat(n) { return (n == null || isNaN(n)) ? 'null' : String(n); }

function parsePrice(s) {
    if (s === '' || s == null) return null;
    const n = parseFloat(String(s).replace(',', '.'));
    return isNaN(n) ? null : n;
}

function fmtPrice(v) {
    if (v == null || v === '') return '–';
    return 'R$ ' + Number(v).toFixed(2).replace('.', ',');
}

function fmtPriceShort(v) {
    if (v == null) return '–';
    return 'R$ ' + Number(v).toFixed(2).replace('.', ',');
}

function statusMeta(v) {
    return STATUS_OPTIONS.find(o => o.value === v) || { label: v, cls: '' };
}

function escHtml(s) {
    return String(s ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
}

function bestPrice(row) {
    const prices = [row.preco_manual, row.preco_extraido, row.preco_lista]
        .filter(p => p != null && !isNaN(p));
    if (!prices.length) return null;
    return Math.min(...prices);
}

async function exec(code) {
    const resp = await fetch(API_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code }),
    });
   
    // NOVO: intercepta 401 e redireciona para login
    if (icubeAuth.handleAuthError(resp)) {
        throw new Error('Sessão expirada. Faça login novamente.');
    }
   // ===================================================================================
    if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
    const data = await resp.json();
    if (!data.ok) throw new Error(data.error || 'Erro desconhecido');
    return data.output;
}

function notify(msg, type = 'info', timeout = 3500) {
    const el = document.getElementById('notification');
    el.textContent = msg;
    el.className = `notification ${type} show`;
    clearTimeout(el._t);
    el._t = setTimeout(() => el.classList.remove('show'), timeout);
}

function setBusy(busy) {
    state.busy = busy;
    document.querySelectorAll('.btn, .action-btn').forEach(b => {
        if (b.dataset.keepEnabled !== '1') b.disabled = busy;
    });
}

/* ====== Health check ====== */

async function checkHealth() {
    const el = document.getElementById('status-indicator');
    try {
        const r = await fetch('/health');
        if (r.ok) {
            el.textContent = '● Online';
            el.className = 'status-badge status-online';
        } else throw new Error('not ok');
    } catch {
        el.textContent = '● Offline';
        el.className = 'status-badge status-offline';
    }
}

/* ====== Stats ====== */

async function loadStats() {
    const code = `
        db.connect_default();
        let r = db.query("SELECT status_extracao, COUNT(*) AS n FROM cotacoes GROUP BY status_extracao");
        let t = db.query_one("SELECT COUNT(*) AS n FROM cotacoes");
        let s = db.query_one("SELECT COALESCE(SUM(COALESCE(preco_manual, preco_extraido, preco_lista)), 0) AS total FROM cotacoes");
        print(r);
        print(t["n"]);
        print(s["total"]);
    `;
    try {
        const out = await exec(code);
        const lines = out.trim().split('\n');
        const data = JSON.parse(lines[0] || '[]');
        const total = parseInt(lines[1] || '0', 10);
        const somaTotal = parseFloat(lines[2] || '0');
        const counts = {};
        STATUS_OPTIONS.forEach(o => counts[o.value] = 0);
        data.forEach(r => {
            if (counts[r.status_extracao] !== undefined) {
                counts[r.status_extracao] = Number(r.n);
            }
        });
        renderStats(total, counts, somaTotal);
    } catch (e) {
        console.error('Stats falhou:', e);
    }
}

function renderStats(total, counts, soma) {
    const grid = document.getElementById('stats-grid');
    let html = `
        <div class="stat-card">
            <div class="stat-n">${total}</div>
            <div class="stat-label">Total</div>
        </div>
        <div class="stat-card">
            <div class="stat-n">${fmtPriceShort(soma)}</div>
            <div class="stat-label">Soma preços</div>
        </div>
    `;
    STATUS_OPTIONS.forEach(o => {
        html += `<div class="stat-card">
            <div class="stat-n">${counts[o.value] || 0}</div>
            <div class="stat-label">${o.label}</div>
        </div>`;
    });
    grid.innerHTML = html;
}

/* ====== Filters / Query ====== */

function buildWhereClause(filters) {
    const conds = [];
    const params = [];
    let p = 1;

    if (filters.peca) {
        conds.push(`peca_nome ILIKE $${p}`);
        params.push(icubeStr(`%${filters.peca}%`));
        p++;
    }
    if (filters.modelo) {
        conds.push(`peca_modelo ILIKE $${p}`);
        params.push(icubeStr(`%${filters.modelo}%`));
        p++;
    }
    if (filters.fornecedor) {
        conds.push(`fornecedor_nome ILIKE $${p}`);
        params.push(icubeStr(`%${filters.fornecedor}%`));
        p++;
    }
    if (filters.categoria) {
        conds.push(`categoria ILIKE $${p}`);
        params.push(icubeStr(`%${filters.categoria}%`));
        p++;
    }
    if (filters.status) {
        conds.push(`status_extracao = $${p}`);
        params.push(icubeStr(filters.status));
        p++;
    }
    if (filters.precoMin !== '') {
        conds.push(`COALESCE(preco_manual, preco_extraido, preco_lista) >= $${p}`);
        params.push(icubeFloat(filters.precoMin));
        p++;
    }
    if (filters.precoMax !== '') {
        conds.push(`COALESCE(preco_manual, preco_extraido, preco_lista) <= $${p}`);
        params.push(icubeFloat(filters.precoMax));
        p++;
    }
    if (filters.dataDe) {
        conds.push(`criado_em >= $${p}`);
        params.push(`${icubeStr(filters.dataDe)} as datetime`);
        p++;
    }
    if (filters.dataAte) {
        conds.push(`criado_em <= $${p}`);
        params.push(`${icubeStr(filters.dataAte + ' 23:59:59')} as datetime`);
        p++;
    }

    return {
        where: conds.length ? conds.join(' AND ') : '1=1',
        params,
    };
}

async function loadRows() {
    const container = document.getElementById('table-container');
    container.innerHTML = '<div class="loading-state">Carregando...</div>';

    const { where, params } = buildWhereClause(state.filters);
    const offset = (state.page - 1) * PER_PAGE;
    const paramsStr = `[${params.join(', ')}]`;

    const sqlList = `SELECT id, peca_nome, peca_modelo, fornecedor_nome, categoria, link, preco_extraido, preco_lista, preco_manual, status_extracao, criado_em FROM cotacoes WHERE ${where} ORDER BY criado_em DESC LIMIT ${PER_PAGE} OFFSET ${offset}`;
    const sqlCount = `SELECT COUNT(*) AS n FROM cotacoes WHERE ${where}`;

    const code = `
        db.connect_default();
        let r = db.query(${icubeStr(sqlList)}, ${paramsStr});
        let c = db.query_one(${icubeStr(sqlCount)}, ${paramsStr});
        print(r);
        print(c["n"]);
    `;

    try {
        const out = await exec(code);
        const lines = out.trim().split('\n');
        const rows = JSON.parse(lines[0] || '[]');
        state.total = parseInt(lines[1] || '0', 10);
        state.rows = rows;
        renderTable(rows);
        renderPagination();
        document.getElementById('results-info').textContent =
            `Mostrando ${rows.length} de ${state.total} cotação(ões) · Página ${state.page}`;
    } catch (e) {
        container.innerHTML = `<div class="error-state"><strong>Erro ao carregar:</strong><pre>${escHtml(e.message)}</pre></div>`;
        document.getElementById('results-info').textContent = '';
    }
}

function renderTable(rows) {
    const container = document.getElementById('table-container');
    if (!rows.length) {
        container.innerHTML = '<div class="empty-state">Nenhuma cotação encontrada</div>';
        return;
    }
    let html = `<div class="table-wrapper"><table>
        <thead><tr>
            <th>ID</th>
            <th>Peça</th>
            <th>Fornecedor</th>
            <th>Categoria</th>
            <th>Melhor preço</th>
            <th>Status</th>
            <th>Ações</th>
        </tr></thead><tbody>`;

    for (const r of rows) {
        const meta = statusMeta(r.status_extracao);
        const best = bestPrice(r);
        const pecaDisplay = r.peca_modelo
            ? `${escHtml(r.peca_nome)} <small style="color:var(--text-muted)">(${escHtml(r.peca_modelo)})</small>`
            : escHtml(r.peca_nome);
        html += `<tr>
            <td>#${escHtml(r.id)}</td>
            <td><strong>${pecaDisplay}</strong></td>
            <td>${escHtml(r.fornecedor_nome || '–')}</td>
            <td>${escHtml(r.categoria || '–')}</td>
            <td class="price-best">${fmtPrice(best)}</td>
            <td><span class="status ${meta.cls}">${escHtml(meta.label)}</span></td>
            <td class="actions-cell">
                <button class="action-btn" title="Comparar fornecedores" onclick="openCompareById(${Number(r.id)})">⚖️</button>
                <button class="action-btn" title="Exportar EML" onclick="exportEmlOne(${Number(r.id)})">📧</button>
                <button class="action-btn" title="Editar" onclick="openEditModal(${Number(r.id)})">✏️</button>
                <button class="action-btn" title="Remover" onclick="confirmDelete(${Number(r.id)})">🗑️</button>
                <button class="action-btn" title="Análise com IA" onclick="openAiModal(${Number(r.id)})">🤖</button>
            </td>
        </tr>`;
    }
    html += '</tbody></table></div>';
    container.innerHTML = html;
}

function renderPagination() {
    const el = document.getElementById('pagination');
    const totalPages = Math.max(1, Math.ceil(state.total / PER_PAGE));
    if (totalPages <= 1) { el.innerHTML = ''; return; }

    let html = '';
    html += `<button onclick="goPage(1)" ${state.page === 1 ? 'disabled' : ''}>«</button>`;
    html += `<button onclick="goPage(${state.page - 1})" ${state.page === 1 ? 'disabled' : ''}>‹</button>`;
    const start = Math.max(1, state.page - 2);
    const end = Math.min(totalPages, state.page + 2);
    for (let i = start; i <= end; i++) {
        html += `<button class="${i === state.page ? 'active' : ''}" onclick="goPage(${i})">${i}</button>`;
    }
    html += `<button onclick="goPage(${state.page + 1})" ${state.page === totalPages ? 'disabled' : ''}>›</button>`;
    html += `<button onclick="goPage(${totalPages})" ${state.page === totalPages ? 'disabled' : ''}>»</button>`;
    el.innerHTML = html;
}

function goPage(n) {
    const totalPages = Math.max(1, Math.ceil(state.total / PER_PAGE));
    if (n < 1 || n > totalPages) return;
    state.page = n;
    loadRows();
}

/* ====== Filters ====== */

function applyFilters() {
    state.filters = {
        peca:       document.getElementById('f-peca').value.trim(),
        modelo:     document.getElementById('f-modelo').value.trim(),
        fornecedor: document.getElementById('f-fornecedor').value.trim(),
        categoria:  document.getElementById('f-categoria').value.trim(),
        status:     document.getElementById('f-status').value,
        precoMin:   document.getElementById('f-preco-min').value,
        precoMax:   document.getElementById('f-preco-max').value,
        dataDe:     document.getElementById('f-data-de').value,
        dataAte:    document.getElementById('f-data-ate').value,
    };
    state.page = 1;
    loadRows();
}

function clearFilters() {
    ['f-peca','f-modelo','f-fornecedor','f-categoria','f-status',
     'f-preco-min','f-preco-max','f-data-de','f-data-ate']
        .forEach(id => document.getElementById(id).value = '');
    state.filters = {
        peca:'', modelo:'', fornecedor:'', categoria:'', status:'',
        precoMin:'', precoMax:'', dataDe:'', dataAte:'',
    };
    state.page = 1;
    loadRows();
}

function toggleFilters() {
    const body = document.getElementById('filters-body');
    const btn = document.getElementById('filters-toggle');
    if (body.style.display === 'none') {
        body.style.display = 'block';
        btn.textContent = 'Recolher ▲';
    } else {
        body.style.display = 'none';
        btn.textContent = 'Expandir ▼';
    }
}

/* ====== Load by ID ====== */

async function loadById(id) {
    const code = `
        db.connect_default();
        let r = db.query_one("SELECT id, peca_nome, peca_modelo, fornecedor_nome, categoria, link, preco_extraido, preco_lista, preco_manual, status_extracao, detalhe_extracao, observacoes, foto, criado_em, atualizado_em FROM cotacoes WHERE id = $1", [${icubeInt(id)}]);
        if r == null { throw "Cotacao nao encontrada"; }
        print(r);
    `;
    const out = await exec(code);
    return JSON.parse(out.trim());
}

/* ====== Modals ====== */

function openModal(html) {
    document.getElementById('modal-root').innerHTML = html;
    document.body.style.overflow = 'hidden';
}

function closeAllModals() {
    document.getElementById('modal-root').innerHTML = '';
    document.body.style.overflow = '';
}

/* ====== Form fields ====== */

function renderFormFields(d = {}) {
    const statusOpts = STATUS_OPTIONS.map(o =>
        `<option value="${o.value}" ${d.status_extracao === o.value ? 'selected' : ''}>${o.label}</option>`
    ).join('');

    const priceVal = (v) => v == null ? '' : String(v);

    return `
        <div class="filters-grid">
            <div class="field full-width">
                <label>Peça (nome) *</label>
                <input type="text" id="f-form-peca" value="${escHtml(d.peca_nome || '')}" required>
            </div>
            <div class="field">
                <label>Modelo da peça</label>
                <input type="text" id="f-form-modelo" value="${escHtml(d.peca_modelo || '')}">
            </div>
            <div class="field">
                <label>Categoria</label>
                <input type="text" id="f-form-categoria" value="${escHtml(d.categoria || '')}">
            </div>
            <div class="field">
                <label>Fornecedor</label>
                <input type="text" id="f-form-fornecedor" value="${escHtml(d.fornecedor_nome || '')}">
            </div>
            <div class="field">
                <label>Status extração *</label>
                <select id="f-form-status" required>${statusOpts}</select>
            </div>
            <div class="field full-width">
                <label>Link (URL da peça) *</label>
                <input type="url" id="f-form-link" value="${escHtml(d.link || '')}" placeholder="https://..." required>
            </div>
            <div class="field">
                <label>Preço extraído (R$)</label>
                <input type="number" id="f-form-preco-extraido" step="0.01" min="0" value="${priceVal(d.preco_extraido)}">
            </div>
            <div class="field">
                <label>Preço de lista (R$)</label>
                <input type="number" id="f-form-preco-lista" step="0.01" min="0" value="${priceVal(d.preco_lista)}">
            </div>
            <div class="field">
                <label>Preço manual (R$)</label>
                <input type="number" id="f-form-preco-manual" step="0.01" min="0" value="${priceVal(d.preco_manual)}">
            </div>
            <div class="field full-width">
                <label>Detalhe da extração</label>
                <textarea id="f-form-detalhe" rows="2" placeholder="Log/mensagem do processo de extração">${escHtml(d.detalhe_extracao || '')}</textarea>
            </div>
            <div class="field full-width">
                <label>Observações</label>
                <textarea id="f-form-obs" rows="3">${escHtml(d.observacoes || '')}</textarea>
            </div>
            <div class="field">
                <label>Foto (URL)</label>
                <input type="text" id="f-form-foto" value="${escHtml(d.foto || '')}">
            </div>
        </div>
    `;
}

function collectFormData() {
    return {
        peca_nome:        document.getElementById('f-form-peca').value.trim(),
        peca_modelo:      document.getElementById('f-form-modelo').value.trim(),
        categoria:        document.getElementById('f-form-categoria').value.trim(),
        fornecedor_nome:  document.getElementById('f-form-fornecedor').value.trim(),
        status_extracao:  document.getElementById('f-form-status').value,
        link:             document.getElementById('f-form-link').value.trim(),
        preco_extraido:   parsePrice(document.getElementById('f-form-preco-extraido').value),
        preco_lista:      parsePrice(document.getElementById('f-form-preco-lista').value),
        preco_manual:     parsePrice(document.getElementById('f-form-preco-manual').value),
        detalhe_extracao: document.getElementById('f-form-detalhe').value.trim(),
        observacoes:      document.getElementById('f-form-obs').value.trim(),
        foto:             document.getElementById('f-form-foto').value.trim(),
    };
}

/* ====== CREATE ====== */

function openCreateModal(prefill = {}) {
    const html = `
        <div class="modal-overlay" onclick="if(event.target === this) closeAllModals()">
            <div class="modal">
                <div class="modal-header">
                    <h2>➕ Nova Cotação</h2>
                    <button class="modal-close" onclick="closeAllModals()">×</button>
                </div>
                <div class="modal-body">
                    <form id="form-create" onsubmit="submitCreate(event)">
                        ${renderFormFields({ status_extracao: 'pendente', ...prefill })}
                        <div class="form-actions">
                            <button type="button" class="btn btn-secondary" onclick="closeAllModals()">Cancelar</button>
                            <button type="submit" class="btn btn-success">💾 Cadastrar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    `;
    openModal(html);
    document.getElementById('f-form-peca').focus();
}

async function submitCreate(ev) {
    ev.preventDefault();
    const d = collectFormData();
    if (!d.peca_nome || !d.link || !d.status_extracao) {
        notify('Preencha os campos obrigatórios (peça, link, status)', 'error');
        return;
    }

    const cols = [];
    const vals = [];

    cols.push('peca_nome');       vals.push(icubeStr(d.peca_nome));
    cols.push('link');            vals.push(icubeStr(d.link));
    cols.push('status_extracao'); vals.push(icubeStr(d.status_extracao));

    if (d.peca_modelo)       { cols.push('peca_modelo');       vals.push(icubeStr(d.peca_modelo)); }
    if (d.fornecedor_nome)   { cols.push('fornecedor_nome');   vals.push(icubeStr(d.fornecedor_nome)); }
    if (d.categoria)         { cols.push('categoria');         vals.push(icubeStr(d.categoria)); }
    if (d.preco_extraido != null) { cols.push('preco_extraido'); vals.push(icubeFloat(d.preco_extraido)); }
    if (d.preco_lista != null)    { cols.push('preco_lista');    vals.push(icubeFloat(d.preco_lista)); }
    if (d.preco_manual != null)   { cols.push('preco_manual');   vals.push(icubeFloat(d.preco_manual)); }
    if (d.detalhe_extracao)  { cols.push('detalhe_extracao');  vals.push(icubeStr(d.detalhe_extracao)); }
    if (d.observacoes)       { cols.push('observacoes');       vals.push(icubeStr(d.observacoes)); }
    if (d.foto)              { cols.push('foto');              vals.push(icubeStr(d.foto)); }

    const placeholders = vals.map((_, i) => `$${i + 1}`).join(', ');
    const sql = `INSERT INTO cotacoes (${cols.join(', ')}) VALUES (${placeholders})`;
    const params = vals.join(', ');

    const code = `
        db.connect_default();
        db.execute(${icubeStr(sql)}, [${params}]);
        let r = db.query_one("SELECT id FROM cotacoes ORDER BY id DESC LIMIT 1");
        print(r["id"]);
    `;

    setBusy(true);
    try {
        const out = await exec(code);
        const id = out.trim();
        closeAllModals();
        notify(`Cotação #${id} cadastrada com sucesso`, 'success');
        await Promise.all([loadStats(), loadRows()]);
    } catch (e) {
        notify(`Falha ao cadastrar: ${e.message}`, 'error', 5000);
    } finally {
        setBusy(false);
    }
}

/* ====== EDIT ====== */

async function openEditModal(id) {
    setBusy(true);
    try {
        const d = await loadById(id);
        const html = `
            <div class="modal-overlay" onclick="if(event.target === this) closeAllModals()">
                <div class="modal">
                    <div class="modal-header">
                        <h2>✏️ Editar Cotação #${id}</h2>
                        <button class="modal-close" onclick="closeAllModals()">×</button>
                    </div>
                    <div class="modal-body">
                        <form id="form-edit" onsubmit="submitEdit(event, ${id})">
                            ${renderFormFields(d)}
                            <div class="form-actions">
                                <button type="button" class="btn btn-secondary" onclick="closeAllModals()">Cancelar</button>
                                <button type="submit" class="btn btn-primary">💾 Salvar alterações</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        `;
        openModal(html);
    } catch (e) {
        notify(`Erro ao carregar: ${e.message}`, 'error', 5000);
    } finally {
        setBusy(false);
    }
}

async function submitEdit(ev, id) {
    ev.preventDefault();
    const d = collectFormData();
    if (!d.peca_nome || !d.link || !d.status_extracao) {
        notify('Preencha os campos obrigatórios (peça, link, status)', 'error');
        return;
    }

    const sets = [];
    const vals = [];
    let p = 1;

    sets.push(`peca_nome = $${p++}`);        vals.push(icubeStr(d.peca_nome));
    sets.push(`link = $${p++}`);             vals.push(icubeStr(d.link));
    sets.push(`status_extracao = $${p++}`);  vals.push(icubeStr(d.status_extracao));

    if (d.peca_modelo)     { sets.push(`peca_modelo = $${p++}`);     vals.push(icubeStr(d.peca_modelo)); }
    else                   { sets.push(`peca_modelo = NULL`); }
    if (d.fornecedor_nome) { sets.push(`fornecedor_nome = $${p++}`); vals.push(icubeStr(d.fornecedor_nome)); }
    else                   { sets.push(`fornecedor_nome = NULL`); }
    if (d.categoria)       { sets.push(`categoria = $${p++}`);       vals.push(icubeStr(d.categoria)); }
    else                   { sets.push(`categoria = NULL`); }

    if (d.preco_extraido != null) { sets.push(`preco_extraido = $${p++}`); vals.push(icubeFloat(d.preco_extraido)); }
    else                          { sets.push(`preco_extraido = NULL`); }
    if (d.preco_lista != null)    { sets.push(`preco_lista = $${p++}`);    vals.push(icubeFloat(d.preco_lista)); }
    else                          { sets.push(`preco_lista = NULL`); }
    if (d.preco_manual != null)   { sets.push(`preco_manual = $${p++}`);   vals.push(icubeFloat(d.preco_manual)); }
    else                          { sets.push(`preco_manual = NULL`); }

    if (d.detalhe_extracao) { sets.push(`detalhe_extracao = $${p++}`); vals.push(icubeStr(d.detalhe_extracao)); }
    else                    { sets.push(`detalhe_extracao = NULL`); }
    if (d.observacoes)      { sets.push(`observacoes = $${p++}`);      vals.push(icubeStr(d.observacoes)); }
    else                    { sets.push(`observacoes = NULL`); }
    if (d.foto)             { sets.push(`foto = $${p++}`);             vals.push(icubeStr(d.foto)); }
    else                    { sets.push(`foto = NULL`); }

    sets.push(`atualizado_em = now()`);

    vals.push(icubeInt(id));
    const sql = `UPDATE cotacoes SET ${sets.join(', ')} WHERE id = $${p}`;
    const params = vals.join(', ');

    const code = `
        db.connect_default();
        let n = db.execute(${icubeStr(sql)}, [${params}]);
        print(n);
    `;

    setBusy(true);
    try {
        const out = await exec(code);
        const n = parseInt(out.trim(), 10);
        closeAllModals();
        if (n > 0) {
            notify(`Cotação #${id} atualizada`, 'success');
            await Promise.all([loadStats(), loadRows()]);
        } else {
            notify(`Nenhum registro alterado (#${id} não encontrado?)`, 'error');
        }
    } catch (e) {
        notify(`Falha ao salvar: ${e.message}`, 'error', 5000);
    } finally {
        setBusy(false);
    }
}

/* ====== DELETE ====== */

async function confirmDelete(id) {
    const html = `
        <div class="modal-overlay" onclick="if(event.target === this) closeAllModals()">
            <div class="modal modal-sm">
                <div class="modal-header">
                    <h2>🗑️ Remover Cotação</h2>
                    <button class="modal-close" onclick="closeAllModals()">×</button>
                </div>
                <div class="modal-body">
                    <p>Tem certeza que deseja remover a cotação <strong>#${id}</strong>?</p>
                    <p style="color: var(--danger); margin-top: 8px; font-size: 14px;">Esta ação não pode ser desfeita.</p>
                    <div class="form-actions">
                        <button class="btn btn-secondary" onclick="closeAllModals()">Cancelar</button>
                        <button class="btn btn-danger" onclick="submitDelete(${id})">Sim, remover</button>
                    </div>
                </div>
            </div>
        </div>
    `;
    openModal(html);
}

async function submitDelete(id) {
    const code = `
        db.connect_default();
        let n = db.execute("DELETE FROM cotacoes WHERE id = $1", [${icubeInt(id)}]);
        print(n);
    `;
    setBusy(true);
    try {
        const out = await exec(code);
        const n = parseInt(out.trim(), 10);
        closeAllModals();
        if (n > 0) {
            notify(`Cotação #${id} removida`, 'success');
            await Promise.all([loadStats(), loadRows()]);
        } else {
            notify(`Cotação #${id} não encontrada`, 'error');
        }
    } catch (e) {
        notify(`Falha ao remover: ${e.message}`, 'error', 5000);
    } finally {
        setBusy(false);
    }
}

/* ====== COMPARE (fornecedores da mesma peça) ====== */

async function openCompareById(id) {
    setBusy(true);
    try {
        const d = await loadById(id);
        const code = `
            db.connect_default();
            let r = db.query("SELECT id, fornecedor_nome, link, preco_extraido, preco_lista, preco_manual, status_extracao FROM cotacoes WHERE peca_nome = $1 AND (peca_modelo IS NOT DISTINCT FROM $2) ORDER BY COALESCE(preco_manual, preco_extraido, preco_lista) ASC", [${icubeStr(d.peca_nome)}, ${d.peca_modelo ? icubeStr(d.peca_modelo) : 'null'}]);
            print(r);
        `;
        const out = await exec(code);
        const rows = JSON.parse(out.trim());

        renderCompareModal(d, rows);
    } catch (e) {
        notify(`Erro ao comparar: ${e.message}`, 'error', 5000);
    } finally {
        setBusy(false);
    }
}

function renderCompareModal(base, rows) {
    const partsTitle = `${escHtml(base.peca_nome)}${base.peca_modelo ? ' <small>(' + escHtml(base.peca_modelo) + ')</small>' : ''}`;

    const bests = rows.map(r => bestPrice(r)).filter(v => v != null);
    const minBest = bests.length ? Math.min(...bests) : null;

    let rowsHtml = '';
    for (const r of rows) {
        const best = bestPrice(r);
        const isBest = best != null && best === minBest;
        const meta = statusMeta(r.status_extracao);
        const fornecedor = r.fornecedor_nome ? escHtml(r.fornecedor_nome) : '<em style="color:var(--text-muted)">(sem fornecedor)</em>';
        const linkCell = r.link
            ? `<a href="${escHtml(r.link)}" target="_blank" rel="noopener">abrir ↗</a>`
            : '–';

        rowsHtml += `<tr class="${isBest ? 'compare-best-row' : ''}">
            <td><strong>${fornecedor}</strong></td>
            <td>${fmtPrice(r.preco_extraido)}</td>
            <td>${fmtPrice(r.preco_lista)}</td>
            <td>${fmtPrice(r.preco_manual)}</td>
            <td class="${isBest ? 'price-best' : ''}">${fmtPrice(best)} ${isBest ? '⭐' : ''}</td>
            <td><span class="status ${meta.cls}">${meta.label}</span></td>
            <td>${linkCell}</td>
            <td><button class="btn btn-sm btn-secondary" onclick="openEditModal(${r.id}); closeAllModals();">✏️</button></td>
        </tr>`;
    }

    const html = `
        <div class="modal-overlay" onclick="if(event.target === this) closeAllModals()">
            <div class="modal">
                <div class="modal-header">
                    <h2>⚖️ Comparar fornecedores</h2>
                    <button class="modal-close" onclick="closeAllModals()">×</button>
                </div>
                <div class="modal-body">
                    <p style="margin-bottom:16px;">Peça: <strong>${partsTitle}</strong></p>
                    <p style="margin-bottom:16px;color:var(--text-muted);font-size:14px;">${rows.length} cotação(ões) encontrada(s). Melhor preço destacado com ⭐.</p>

                    <div class="table-wrapper">
                        <table>
                            <thead><tr>
                                <th>Fornecedor</th>
                                <th>Extraído</th>
                                <th>Lista</th>
                                <th>Manual</th>
                                <th>Melhor</th>
                                <th>Status</th>
                                <th>Link</th>
                                <th></th>
                            </tr></thead>
                            <tbody>${rowsHtml}</tbody>
                        </table>
                    </div>

                    <div class="ai-buttons" style="margin-top:20px;">
                        <button class="btn btn-primary" onclick="runCompareAi(${base.id})">🤖 Analisar com IA</button>
                        <button class="btn btn-secondary" onclick="exportCompareEml(${base.id})">📧 Exportar esta comparação</button>
                        <button class="btn btn-success" onclick="openCreateModal({peca_nome: '${escapeIcubeJS(base.peca_nome)}', peca_modelo: '${escapeIcubeJS(base.peca_modelo || '')}'}); closeAllModals();">➕ Adicionar outro fornecedor</button>
                    </div>
                    <div id="ai-result-container"></div>
                </div>
            </div>
        </div>
    `;
    openModal(html);
}

function escapeIcubeJS(s) {
    return String(s ?? '').replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/\n/g, '');
}

async function runCompareAi(baseId) {
    const resultEl = document.getElementById('ai-result-container');
    resultEl.innerHTML = '<div class="loading-state">Analisando cotações com IA...</div>';

    try {
        const d = await loadById(baseId);
        const code = `
            db.connect_default();
            let r = db.query("SELECT fornecedor_nome, preco_extraido, preco_lista, preco_manual, status_extracao FROM cotacoes WHERE peca_nome = $1 AND (peca_modelo IS NOT DISTINCT FROM $2) ORDER BY COALESCE(preco_manual, preco_extraido, preco_lista) ASC", [${icubeStr(d.peca_nome)}, ${d.peca_modelo ? icubeStr(d.peca_modelo) : 'null'}]);
            print(r);
        `;
        const out = await exec(code);
        const rows = JSON.parse(out.trim());

        if (!rows.length) {
            resultEl.innerHTML = '<div class="error-state">Sem cotações para analisar</div>';
            return;
        }

        let ctx = 'Peça: ' + d.peca_nome + (d.peca_modelo ? ' (' + d.peca_modelo + ')' : '') + '\n\n';
        ctx += 'Fornecedores encontrados:\n';
        rows.forEach((r, i) => {
            const best = bestPrice(r);
            ctx += `${i+1}. ${r.fornecedor_nome || '(sem fornecedor)'} — extraído: ${r.preco_extraido ?? 'n/a'}, lista: ${r.preco_lista ?? 'n/a'}, manual: ${r.preco_manual ?? 'n/a'}, melhor: ${best ?? 'n/a'} (${r.status_extracao})\n`;
        });

        const prompt = `Responda em português brasileiro. Analise estas cotações para a mesma peça e recomende qual fornecedor escolher considerando preço e confiabilidade dos dados (extração). Seja objetivo em até 4 frases.\n\n${ctx}`;

        const aiCode = `
            if !ai.is_available() {
                throw "Ollama nao esta disponivel. Inicie com: ollama serve";
            }
            print(ai.ask(${icubeStr(prompt)}));
        `;

        const aiOut = await exec(aiCode);
        resultEl.innerHTML = `<div class="ai-result">${escHtml(aiOut.trim())}</div>`;
    } catch (e) {
        resultEl.innerHTML = `<div class="error-state"><strong>Erro:</strong><pre>${escHtml(e.message)}</pre></div>`;
    }
}

/* ====== AI ====== */

async function openAiModal(id) {
    setBusy(true);
    try {
        const d = await loadById(id);
        const best = bestPrice(d);
        const html = `
            <div class="modal-overlay" onclick="if(event.target === this) closeAllModals()">
                <div class="modal">
                    <div class="modal-header">
                        <h2>🤖 Análise IA — Cotação #${id}</h2>
                        <button class="modal-close" onclick="closeAllModals()">×</button>
                    </div>
                    <div class="modal-body">
                        <p><strong>${escHtml(d.peca_nome)}</strong>${d.peca_modelo ? ' <small>(' + escHtml(d.peca_modelo) + ')</small>' : ''}</p>
                        <p style="color: var(--text-muted); margin: 8px 0; font-size: 14px;"><strong>Fornecedor:</strong> ${escHtml(d.fornecedor_nome || '–')}</p>
                        <p style="color: var(--text-muted); margin: 8px 0; font-size: 14px;"><strong>Preços:</strong> extraído ${fmtPrice(d.preco_extraido)} · lista ${fmtPrice(d.preco_lista)} · manual ${fmtPrice(d.preco_manual)}</p>
                        <p style="color: var(--text-muted); margin-bottom: 8px; font-size: 14px;"><strong>Melhor preço:</strong> <span class="price-best">${fmtPrice(best)}</span></p>

                        <div class="ai-buttons">
                            <button class="btn btn-primary" onclick="runAi('price', ${id})">💰 Analisar preços</button>
                            <button class="btn btn-primary" onclick="runAi('category', ${id})">🏷️ Sugerir categoria</button>
                            <button class="btn btn-primary" onclick="runAi('fairness', ${id})">⚖️ Preço é justo?</button>
                        </div>

                        <div id="ai-result-container"></div>
                    </div>
                </div>
            </div>
        `;
        openModal(html);
    } catch (e) {
        notify(`Erro ao carregar: ${e.message}`, 'error', 5000);
    } finally {
        setBusy(false);
    }
}

async function runAi(type, id) {
    const resultEl = document.getElementById('ai-result-container');
    resultEl.innerHTML = '<div class="loading-state">Consultando IA... (pode levar 5-30s)</div>';

    try {
        const d = await loadById(id);
        const best = bestPrice(d);
        let prompt;

        if (type === 'price') {
            prompt = `Responda em português brasileiro. Para a peça "${d.peca_nome}"${d.peca_modelo ? ' modelo ' + d.peca_modelo : ''}, temos 3 preços:\n- Preço extraído automaticamente: R$ ${d.preco_extraido ?? 'n/a'}\n- Preço de lista: R$ ${d.preco_lista ?? 'n/a'}\n- Preço manual: R$ ${d.preco_manual ?? 'n/a'}\n\nAnalise a coerência entre os valores. Há grande variação? Qual é o mais confiável? Recomende qual usar. Seja objetivo em até 3 frases.`;
        } else if (type === 'category') {
            prompt = `Responda em português brasileiro com UMA palavra (ex: Armazenamento, Memória, Tela, Placa-mãe, Teclado, Bateria, Fonte, Ventilação, Cabo). Para a peça: "${d.peca_nome}"${d.peca_modelo ? ' modelo ' + d.peca_modelo : ''}.`;
        } else {
            const preco = best != null ? `R$ ${best.toFixed(2)}` : 'desconhecido';
            prompt = `Responda em português brasileiro em 2 frases. Para a peça "${d.peca_nome}"${d.peca_modelo ? ' modelo ' + d.peca_modelo : ''} com preço de ${preco}, está caro, razoável ou barato no mercado brasileiro de 2026? Considere o contexto de manutenção de equipamentos.`;
        }

        const code = `
            if !ai.is_available() {
                throw "Ollama nao esta disponivel. Inicie com: ollama serve";
            }
            print(ai.ask(${icubeStr(prompt)}));
        `;

        const out = await exec(code);
        resultEl.innerHTML = `<div class="ai-result">${escHtml(out.trim())}</div>`;
    } catch (e) {
        resultEl.innerHTML = `<div class="error-state"><strong>Erro na IA:</strong><pre>${escHtml(e.message)}</pre></div>`;
    }
}

/* ========================================================
   EXPORTAÇÃO EML (email RFC 5322)
   ======================================================== */

/**
 * Codifica o assunto do email (RFC 2047) se tiver caracteres não-ASCII.
 * Sem isso, acentos podem quebrar o header Subject.
 */
function encodeRfc2047(str) {
    if (/^[\x00-\x7F]*$/.test(str)) return str;
    const utf8 = unescape(encodeURIComponent(str));
    return '=?UTF-8?B?' + btoa(utf8) + '?=';
}

/**
 * Gera o corpo HTML do email (inline CSS — email clients ignoram <style>).
 */
function buildEmlHtml(cotacoes) {
    const dataGer = new Date().toLocaleString('pt-BR');
    let html = `<!DOCTYPE html>
<html lang="pt-BR">
<head><meta charset="UTF-8"></head>
<body style="font-family:Arial,Helvetica,sans-serif;color:#222;max-width:800px;margin:0 auto;padding:20px;background:#f5f5f5;">
    <div style="background:#fff;padding:24px;border-radius:8px;">
        <h2 style="color:#1976d2;border-bottom:2px solid #1976d2;padding-bottom:8px;margin-top:0;">
            Cotações de Equipamentos
        </h2>
        <p style="color:#666;font-size:14px;">
            Gerado em ${escHtml(dataGer)} pelo sistema Icube.
        </p>

        <table border="0" cellpadding="10" cellspacing="0"
               style="border-collapse:collapse;width:100%;font-size:14px;border:1px solid #e0e0e0;">
            <thead>
                <tr style="background:#1976d2;color:#fff;">
                    <th align="left" style="padding:10px;border:1px solid #1976d2;">Peça</th>
                    <th align="left" style="padding:10px;border:1px solid #1976d2;">Modelo</th>
                    <th align="left" style="padding:10px;border:1px solid #1976d2;">Fornecedor</th>
                    <th align="left" style="padding:10px;border:1px solid #1976d2;">Link</th>
                </tr>
            </thead>
            <tbody>`;

    for (const c of cotacoes) {
        const peca = c.peca_nome || '–';
        const modelo = c.peca_modelo || '–';
        const fornecedor = c.fornecedor_nome || '–';
        const link = c.link || '';

        const linkHtml = link
            ? `<a href="${escHtml(link)}" style="color:#1976d2;text-decoration:none;">${escHtml(link)}</a>`
            : '<span style="color:#999;">–</span>';

        html += `
                <tr>
                    <td style="padding:10px;border:1px solid #e0e0e0;"><strong>${escHtml(peca)}</strong></td>
                    <td style="padding:10px;border:1px solid #e0e0e0;">${escHtml(modelo)}</td>
                    <td style="padding:10px;border:1px solid #e0e0e0;">${escHtml(fornecedor)}</td>
                    <td style="padding:10px;border:1px solid #e0e0e0;word-break:break-all;">${linkHtml}</td>
                </tr>`;
    }

    html += `
            </tbody>
        </table>

        <p style="color:#999;font-size:12px;margin-top:24px;text-align:center;">
            Este email foi gerado automaticamente pelo sistema Icube v0.7.4.
        </p>
    </div>
</body>
</html>`;
    return html;
}

/**
 * Monta o arquivo EML completo (headers + body).
 * Usa CRLF (\r\n) conforme RFC 5322.
 */
function buildEml(cotacoes, assunto) {
    const crlf = '\r\n';
    const now = new Date().toUTCString();
    const htmlBody = buildEmlHtml(cotacoes);

    const headers = [
        `From: Icube <noreply@icube.local>`,
        `To: destinatario@example.com`,
        `Subject: ${encodeRfc2047(assunto)}`,
        `Date: ${now}`,
        `MIME-Version: 1.0`,
        `Content-Type: text/html; charset=UTF-8`,
        `Content-Transfer-Encoding: 8bit`,
        `X-Mailer: Icube v0.7.4`,
    ];

    // Header block + linha em branco (CRLF) + body com CRLF
    const headerBlock = headers.join(crlf);
    const bodyWithCrlf = htmlBody.replace(/\n/g, crlf);
    return headerBlock + crlf + crlf + bodyWithCrlf;
}

/**
 * Dispara o download do arquivo .eml.
 */
function downloadEml(filename, content) {
    const blob = new Blob([content], { type: 'message/rfc822' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    setTimeout(() => URL.revokeObjectURL(url), 1000);
}

/**
 * Gera um nome de arquivo seguro (sem acentos, sem espaços).
 */
function sanitizeFilename(s) {
    return String(s ?? 'cotacao')
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-zA-Z0-9-_]/g, '-')
        .replace(/-+/g, '-')
        .replace(/^-|-$/g, '')
        .toLowerCase()
        .slice(0, 60);
}

/**
 * Exporta UMA cotação para EML.
 */
async function exportEmlOne(id) {
    setBusy(true);
    try {
        const d = await loadById(id);
        const assunto = `Cotação: ${d.peca_nome}${d.peca_modelo ? ' (' + d.peca_modelo + ')' : ''}`;
        const eml = buildEml([d], assunto);
        const filename = `cotacao-${sanitizeFilename(d.peca_nome)}-${id}.eml`;
        downloadEml(filename, eml);
        notify(`Arquivo "${filename}" gerado`, 'success');
    } catch (e) {
        notify(`Falha ao exportar: ${e.message}`, 'error', 5000);
    } finally {
        setBusy(false);
    }
}

/**
 * Exporta TODAS as cotações filtradas (não só a página atual) para EML.
 */
async function exportEmlAll() {
    setBusy(true);
    try {
        const { where, params } = buildWhereClause(state.filters);
        const paramsStr = `[${params.join(', ')}]`;
        const sql = `SELECT id, peca_nome, peca_modelo, fornecedor_nome, categoria, link FROM cotacoes WHERE ${where} ORDER BY peca_nome ASC, COALESCE(preco_manual, preco_extraido, preco_lista) ASC`;
        const code = `
            db.connect_default();
            print(db.query(${icubeStr(sql)}, ${paramsStr}));
        `;
        const out = await exec(code);
        const rows = JSON.parse(out.trim());

        if (!rows.length) {
            notify('Nenhuma cotação para exportar', 'error');
            return;
        }

        const assunto = `Cotações (${rows.length} item${rows.length > 1 ? 's' : ''}) — ${new Date().toLocaleDateString('pt-BR')}`;
        const eml = buildEml(rows, assunto);
        const filename = `cotacoes-${new Date().toISOString().slice(0, 10)}.eml`;
        downloadEml(filename, eml);
        notify(`Arquivo "${filename}" gerado (${rows.length} cotações)`, 'success');
    } catch (e) {
        notify(`Falha ao exportar: ${e.message}`, 'error', 5000);
    } finally {
        setBusy(false);
    }
}

/**
 * Exporta a comparação atual (mesma peça + modelo) para EML.
 */
async function exportCompareEml(baseId) {
    setBusy(true);
    try {
        const d = await loadById(baseId);
        const code = `
            db.connect_default();
            let r = db.query("SELECT id, peca_nome, peca_modelo, fornecedor_nome, categoria, link, preco_extraido, preco_lista, preco_manual, status_extracao FROM cotacoes WHERE peca_nome = $1 AND (peca_modelo IS NOT DISTINCT FROM $2) ORDER BY COALESCE(preco_manual, preco_extraido, preco_lista) ASC", [${icubeStr(d.peca_nome)}, ${d.peca_modelo ? icubeStr(d.peca_modelo) : 'null'}]);
            print(r);
        `;
        const out = await exec(code);
        const rows = JSON.parse(out.trim());

        if (!rows.length) {
            notify('Sem cotações para exportar', 'error');
            return;
        }

        const assunto = `Comparação de fornecedores: ${d.peca_nome}${d.peca_modelo ? ' (' + d.peca_modelo + ')' : ''}`;
        const eml = buildEml(rows, assunto);
        const filename = `comparacao-${sanitizeFilename(d.peca_nome)}-${baseId}.eml`;
        downloadEml(filename, eml);
        notify(`Arquivo "${filename}" gerado (${rows.length} fornecedores)`, 'success');
    } catch (e) {
        notify(`Falha ao exportar: ${e.message}`, 'error', 5000);
    } finally {
        setBusy(false);
    }
}

/* ====== Init ====== */

async function init() {
    checkHealth();
    await Promise.all([loadStats(), loadRows()]);
}

document.addEventListener('DOMContentLoaded', init);