/**
 * Helper de autenticação Icube.
 * Use em qualquer página protegida.
 */
const icubeAuth = {
    currentUser: null,

    async check(redirectToLogin = true) {
        try {
            const r = await fetch('/api/me', { credentials: 'include' });
            const d = await r.json();
            if (!d.authenticated) {
                if (redirectToLogin) this.goToLogin();
                return null;
            }
            this.currentUser = d.user;
            return d.user;
        } catch (e) {
            console.error('[auth] erro ao verificar:', e);
            if (redirectToLogin) this.goToLogin();
            return null;
        }
    },

    goToLogin() {
        const here = location.pathname + location.search;
        if (location.pathname.endsWith('/login.html')) return;
        location.href = `/login.html?redirect=${encodeURIComponent(here)}`;
    },

    renderBadge(elementId, user) {
        const el = document.getElementById(elementId);
        if (!el || !user) return;
        const roleLabel = {
            'administrator': 'Admin',
            'colaborador': 'Colaborador',
            'visitante': 'Visitante',
        }[user.role] || user.role;
        el.innerHTML = `👤 ${user.username} <small>(${roleLabel})</small><button onclick="icubeAuth.logout()">sair</button>`;
    },

    async logout() {
        try {
            await fetch('/api/logout', { method: 'POST', credentials: 'include' });
        } catch (e) {
            console.error('[auth] erro no logout:', e);
        } finally {
            location.href = '/login.html';
        }
    },

    handleAuthError(response) {
        if (response.status === 401) {
            this.goToLogin();
            return true;
        }
        return false;
    },
};